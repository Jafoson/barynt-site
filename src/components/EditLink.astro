---
// "Edit page" opens the file in Barynt's docs/guide/, wherever the build
// found the folder.
import Default from "@astrojs/starlight/components/EditLink.astro";
import { relative, resolve } from "node:path";
import { DOCS_DIR } from "../site.mjs";

const file = Astro.locals.starlightRoute.entry.filePath;
if (file) {
  const path = relative(DOCS_DIR, resolve(file)).replaceAll("\\", "/");
  // The developer docs are prepared copies (scripts/build.ts); edit the original.
  const dev = path.match(/^en\/development\/(.+)\.md$/);
  Astro.locals.starlightRoute.editUrl = new URL(
    dev
      ? `https://github.com/barynt-dev/barynt-web/edit/main/docs/dev/${dev[1] === "overview" ? "README" : dev[1]}.md`
      : `https://github.com/barynt-dev/barynt-web/edit/main/docs/guide/${path}`,
  );
}
---

<Default />
